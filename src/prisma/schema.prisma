generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  imageUrl  String     @unique
  positions Position[]
  records   Record[]
}

model Position {
  level       Level     @relation(fields: [levelId], references: [id])
  levelId     Int
  character   Character @relation(fields: [characterId], references: [id])
  characterId Int
  startX      Int
  endX        Int
  startY      Int
  endY        Int

  @@id([levelId, characterId])
}

model Character {
  id        Int        @id @default(autoincrement())
  imageUrl  String     @unique
  name      String     @unique
  positions Position[]
}

model Record {
  id          Int    @id @default(autoincrement())
  username    String
  timeSeconds Int
  level       Level  @relation(fields: [levelId], references: [id])
  levelId     Int
}
