generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id       Int    @id @default(autoincrement())
  name     String
  startX   Int
  endX     Int
  startY   Int
  endY     Int
  levelId  Int
  imageUrl String @unique
  Level    Level  @relation(fields: [levelId], references: [id])
}

model Level {
  id        Int         @id @default(autoincrement())
  name      String
  imageUrl  String      @unique
  widthPx   Int
  heightPx  Int
  Character Character[]
  Record    Record[]
}

model Record {
  id          Int    @id @default(autoincrement())
  username    String @unique
  timeSeconds Int
  levelId     Int
  Level       Level  @relation(fields: [levelId], references: [id])
}
